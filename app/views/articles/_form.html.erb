<div class="card shadow-sm p-4">
  <%= form_with model: article do |f| %>
    <div class="mb-3">
      <%= f.label :title, class: "form-label fw-bold" %>
      <%= f.text_field :title, class: "form-control", placeholder: "Enter title..." %>
    </div>

    <div class="mb-3">
      <%= f.label :content, class: "form-label fw-bold" %>
      <%= f.text_area :content, class: "form-control", rows: 5, placeholder: "Enter content..." %>
    </div>

    <div class="d-grid gap-2">
      <%= f.submit class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
