<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <div class="mb-3">
        <%= link_to "← Back to articles", articles_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>

      <div class="card shadow-sm p-4 mb-4">
        <h1 class="h2 fw-bold text-dark mb-3"><%= @article.title %></h1>
        <hr class="text-muted my-3">
        <p class="card-text text-body fs-5 lh-base" style="white-space: pre-line;"><%= @article.content %></p>
      </div>

      <div class="d-flex gap-2">
        <%= link_to "Edit article", edit_article_path(@article), class: "btn btn-primary" %>
        <%= link_to "Delete article", article_path(@article),
            class: "btn btn-outline-danger",
            data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      </div>

    </div>
  </div>
</div>
